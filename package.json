{
  "name": "divine-prophetic-strategies",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:stable": "WATCHPACK_POLLING=true next dev --hostname 127.0.0.1 --port 3000",
    "build": "prisma migrate deploy && tsx prisma/seed.ts && next build",
    "start": "next start",
    "lint": "next lint || echo 'lint skipped'",
    "test": "tsx --test tests/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write --ignore-unknown",
    "postinstall": "prisma generate",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "d3": "^7.9.0",
    "framer-motion": "12.23.19",
    "jose": "^6.2.2",
    "lucide-react": "0.544.0",
    "maplibre-gl": "^5.7.0",
    "mysql2": "^3.22.2",
    "next": "15.5.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "resend": "^6.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "postcss": "8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^7.7.0",
    "tailwindcss": "4.1.13",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  },
  "packageManager": "yarn@4.10.3"
}